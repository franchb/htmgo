# This Dockerfile ships with every project generated by `htmgo template`, so it
# builds from the project directory: docker build .
#
# The "framework" stage is empty by default. The htmgo monorepo's release
# workflow overrides it with the framework source from the same commit, which
# the template's replace directive (../../framework, i.e. /framework from /app)
# points at:
#
#   docker build --build-context framework=framework templates/starter
FROM scratch AS framework

# Stage 1: Build the Go binary
FROM golang:1.27 AS builder

# Static binary, independent of the builder's glibc version.
ENV CGO_ENABLED=0

COPY --from=framework / /framework/

# Set the working directory inside the container
WORKDIR /app

# Copy go.mod and go.sum files
COPY go.mod go.sum ./

# Download and cache the Go modules
RUN go mod download

# Copy the source code into the container
COPY . .

# Build the Go binary for Linux
RUN go run github.com/franchb/htmgo/cli/htmgo/v2@latest build


# Stage 2: Create the smallest possible image
FROM gcr.io/distroless/base-debian12

# Set the working directory inside the container
WORKDIR /app

# Copy the Go binary from the builder stage
COPY --from=builder /app/dist .

# Expose the necessary port (replace with your server port)
EXPOSE 3000


# Command to run the binary
CMD ["./starter-template"]
